            <pose>0 1.0 0 0 0 0</pose>
        </joint>
        <!-- Revolute joints for the three actuated axes -->
        <joint name="jbf1" type="revolute">
            <parent>base_hex</parent>
            <child>forearm1</child>
            <pose>-0.041901939908467044 0.02578501478731749 7.87069767520482e-18 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>                <!-- Simplified axis direction -->
                <limit>
                    <lower>-2.007128639793479</lower>
                    <upper>2.007128639793479</upper>
                    <effort>2.0</effort>                    <!-- 20 kg·cm ≈ 2 N·m -->
                    <velocity>5.0</velocity>                    <!-- Typical servo speed ~60°/0.1s = ~10 rad/s -->
                </limit>
                <dynamics>
                    <damping>0.1</damping>                    <!-- Reduce for servo-like response -->
                    <friction>0.05</friction>
                </dynamics>
            </axis>
        </joint>
