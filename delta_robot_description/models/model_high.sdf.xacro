<?xml version='1.0' encoding='utf-8'?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.7">
    <!-- ══════════════════════════════════════════════════════════
         PROPERTIES
    ══════════════════════════════════════════════════════════ -->
    <xacro:property name="meshes" value="package://delta_robot_description/meshes"/>
    <!-- ══════════════════════════════════════════════════════════
         MATERIAL MACROS
    ══════════════════════════════════════════════════════════ -->
    <xacro:macro name="material_aluminium">
        <material>
            <ambient>0.2  0.2  0.2  1</ambient>
            <diffuse>0.3  0.3  0.3  1</diffuse>
            <specular>1.0  1.0  1.0  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_anodised_aluminium">
        <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_aluminium">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.8  0.8  0.8  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_white_pla">
        <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_pla">
        <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_orange_pla">
        <material>
            <ambient>0.4  0.15 0.0  1</ambient>
            <diffuse>1.0  0.4  0.0  1</diffuse>
            <specular>0.1  0.1  0.1  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_abs">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.3  0.3  0.3  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_carbon_fiber">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>1.0  1.0  1.0  1</specular>
        </material>
    </xacro:macro>
    <!-- ══════════════════════════════════════════════════════════
         INERTIA MACROS
         Cross-terms (ixy/ixz/iyz) with |value| < 1e-9 are zeroed.
         Negligible CoM pose offsets below the same threshold are also zeroed.
    ══════════════════════════════════════════════════════════ -->
    <!-- Servo mount (×3) -->
    <xacro:macro name="inertial_servo_mount">
        <inertial>
            <mass>0.0241270257</mass>
            <pose>0.000332283 -1.10259e-05 -0.00742638 0 0 0</pose>
            <inertia>
                <ixx>3.7563e-06</ixx>
                <ixy>-4.7e-09</ixy>
                <ixz>3.691e-07</ixz>
                <iyy>6.6333e-06</iyy>
                <iyz>-5.1e-09</iyz>
                <izz>6.1105e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Servo body (×3) -->
    <xacro:macro name="inertial_servo">
        <inertial>
            <mass>0.2665419134</mass>
            <pose>-0.0292907 0.0100195 0.013 0 0 0</pose>
            <inertia>
                <ixx>3.47326e-05</ixx>
                <ixy>-2.3e-07</ixy>
                <ixz>0</ixz>
                <iyy>5.71427e-05</iyy>
                <iyz>0</iyz>
                <izz>6.56729e-05</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Servo horn / free-horn (×6) — driven (motor_joint_1/2/3 children) -->
    <xacro:macro name="inertial_servo_horn">
        <inertial>
            <mass>0.0063187985</mass>
            <pose>-2.7011e-06 0.00300658 2.7463e-06 0 0 0</pose>
            <inertia>
                <ixx>1.378e-07</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>2.59e-07</iyy>
                <iyz>0</iyz>
                <izz>1.378e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Bicep (×3) -->
    <xacro:macro name="inertial_bicep">
        <inertial>
            <mass>0.0299135472</mass>
            <pose>0.0192 0.034737 -0.000404853 0 0 0</pose>
            <inertia>
                <ixx>3.23451e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>5.9246e-06</iyy>
                <iyz>-2.856e-07</iyz>
                <izz>3.55198e-05</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Upper pivot arm (×3) -->
    <xacro:macro name="inertial_pivot_arm_upper">
        <inertial>
            <mass>0.0390860375</mass>
            <pose>0 0 -0.00562255 0 0 0</pose>
            <inertia>
                <ixx>1.09743e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>1.2263e-05</iyy>
                <iyz>0</iyz>
                <izz>1.9206e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Upper rod-cap (×6) -->
    <xacro:macro name="inertial_rod_cap_upper">
        <inertial>
            <mass>0.0225389015</mass>
            <pose>3.6e-08 -0.0043487373 -0.0088260621 0 0 0</pose>
            <inertia>
                <ixx>1.3755e-06</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>9.166e-07</iyy>
                <iyz>-4.64e-08</iyz>
                <izz>9.897e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Forearm (×6) -->
    <xacro:macro name="inertial_forearm">
        <inertial>
            <mass>0.0405706145</mass>
            <pose>0 0 -0.0950335 0 0 0</pose>
            <inertia>
                <ixx>0.0001222238</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.0001222238</iyy>
                <iyz>0</iyz>
                <izz>1.756e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Lower rod-cap (×6) -->
    <xacro:macro name="inertial_rod_cap_lower">
        <inertial>
            <mass>0.022829726</mass>
            <pose>0.000473902 -0.0006512435 3.6e-08 0 0 0</pose>
            <inertia>
                <ixx>1.0025e-06</ixx>
                <ixy>4.7e-08</ixy>
                <ixz>0</ixz>
                <iyy>9.284e-07</iyy>
                <iyz>0</iyz>
                <izz>1.3932e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Lower pivot arm (×3) -->
    <xacro:macro name="inertial_pivot_arm_lower">
        <inertial>
            <mass>0.0390860375</mass>
            <pose>0.0093 0 -0.0256226 0 0 0</pose>
            <inertia>
                <ixx>1.09743e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>1.2263e-05</iyy>
                <iyz>0</iyz>
                <izz>1.9206e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- STS circular horn / bevel pinion (×2) — driven (differential_pinion_joint_1/2 children) -->
    <xacro:macro name="inertial_sts_circular_horn">
        <inertial>
            <mass>0.0039017949</mass>
            <pose>0.0012497970 0 0 0 0 0</pose>
            <inertia>
                <ixx>1.4960e-07</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>7.8203e-08</iyy>
                <iyz>0</iyz>
                <izz>7.8203e-08</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- ══════════════════════════════════════════════════════════
         UTILITY MACROS
    ══════════════════════════════════════════════════════════ -->
    <!-- mesh_geometry -->
    <xacro:macro name="mesh_geometry" params="file">
        <geometry>
            <mesh>
                <uri>${meshes}/${file}</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
    </xacro:macro>
    <!-- fixed_joint -->
    <xacro:macro name="fixed_joint" params="name parent child">
        <joint name="${name}" type="fixed">
            <parent>${parent}</parent>
            <child>${child}</child>
        </joint>
    </xacro:macro>
    <!-- revolute_joint -->
    <xacro:macro name="revolute_joint" params="name parent child ax ay az">
        <joint name="${name}" type="revolute">
            <parent>${parent}</parent>
            <child>${child}</child>
            <axis>
                <xyz>${ax} ${ay} ${az}</xyz>
            </axis>
        </joint>
    </xacro:macro>
    <!-- ══════════════════════════════════════════════════════════
         LINK MACROS
    ══════════════════════════════════════════════════════════ -->
    <!-- servo_mount_link (×3) -->
    <xacro:macro name="servo_mount_link" params="n px py pz roll pitch yaw">
        <link name="servo_mount_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="delta_base">${px} ${py} ${pz} ${roll} ${pitch} ${yaw}</pose>
            <xacro:inertial_servo_mount/>
            <visual name="servo_mount_${n}_visual">
                <xacro:mesh_geometry file="servo_mount.stl"/>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_link (×3) -->
    <xacro:macro name="servo_link" params="n">
        <link name="servo_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="servo_mount_${n}">0 0 -0.0213 ${pi/2} ${pi/2} 0</pose>
            <xacro:inertial_servo/>
            <visual name="servo_${n}_visual">
                <xacro:mesh_geometry file="servo.stl"/>
                <xacro:material_black_abs/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_horn_link (×3) -->
    <xacro:macro name="servo_horn_link" params="n">
        <link name="servo_${n}_horn">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}">0 0 0 0 0 0</pose>
            <xacro:inertial_servo_horn/>
            <visual name="servo_${n}_horn_visual">
                <pose>-0.0125 0 0 0 0 0</pose>
                <xacro:mesh_geometry file="servo_horn.stl"/>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_free_horn_link (×3) -->
    <xacro:macro name="servo_free_horn_link" params="n">
        <link name="servo_${n}_free_horn">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}">0 0 0 0 0 0</pose>
            <xacro:inertial_servo_horn/>
            <visual name="servo_${n}_free_horn_visual">
                <pose>-0.0125 0 0 0 0 0</pose>
                <xacro:mesh_geometry file="servo_free_horn.stl"/>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- bicep_link (×3) -->
    <xacro:macro name="bicep_link" params="n">
        <link name="bicep_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}_horn">0 0 0 0 0 ${-pi/2}</pose>
            <xacro:inertial_bicep/>
            <visual name="bicep_${n}_visual">
                <xacro:mesh_geometry file="bicep.stl"/>
                <xacro:material_white_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- pivot_arm_upper_link (×3) -->
    <xacro:macro name="pivot_arm_upper_link" params="n px py pz roll pitch yaw">
        <link name="pivot_arm_${n}">
            <self_collide>false</self_collide>
            <pose>${px} ${py} ${pz} ${roll} ${pitch} ${yaw}</pose>
            <xacro:inertial_pivot_arm_upper/>
            <visual name="pivot_arm_${n}_visual">
                <xacro:mesh_geometry file="pivot_arm.stl"/>
                <xacro:material_white_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- rod_cap_upper_link (×6) -->
    <xacro:macro name="rod_cap_upper_link" params="n relative_to z_offset">
        <link name="rod_cap_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 ${z_offset} 0 0 0</pose>
            <xacro:inertial_rod_cap_upper/>
            <visual name="rod_cap_${n}_visual">
                <pose>0 0.005 0 0 0 0</pose>
                <xacro:mesh_geometry file="rod_cap_2.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- forearm_link (×6) -->
    <xacro:macro name="forearm_link" params="n relative_to">
        <link name="forearm_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0.258 0 ${pi/2} ${pi} 0</pose>
            <xacro:inertial_forearm/>
            <visual name="forearm_${n}_visual">
                <xacro:mesh_geometry file="forearm.stl"/>
                <xacro:material_carbon_fiber/>
            </visual>
        </link>
    </xacro:macro>
    <!-- rod_cap_lower_link (×6) -->
    <xacro:macro name="rod_cap_lower_link" params="n relative_to roll">
        <link name="rod_cap_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 0 ${roll} ${pi} 0</pose>
            <xacro:inertial_rod_cap_lower/>
            <visual name="rod_cap_${n}_visual">
                <xacro:mesh_geometry file="rod_cap_2.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- pivot_arm_lower_link (×3) -->
    <xacro:macro name="pivot_arm_lower_link" params="n relative_to">
        <link name="pivot_arm_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 -0.005 0 0 0 0</pose>
            <xacro:inertial_pivot_arm_lower/>
            <visual name="pivot_arm_${n}_visual">
                <pose>0 0 -0.016 0 0 0</pose>
                <xacro:mesh_geometry file="pivot_arm.stl"/>
                <xacro:material_white_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- detach_aux_link (×3) — massless aux links for DetachableJoint -->
    <xacro:macro name="detach_aux_link" params="n">
        <link name="rod_cap_${n}_aux">
            <self_collide>false</self_collide>
            <pose relative_to="rod_cap_${n}">0.0093 -0.005 0 0 0 0</pose>
        </link>
    </xacro:macro>
    <!-- end_effector_side_plate_link (×2) -->
    <xacro:macro name="end_effector_side_plate_link" params="n relative_to">
        <link name="end_effector_side_plate_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">${((-1)**n) * 0.0346} 0.025 0 0 ${(n-2) * pi} 0</pose>
            <inertial>
                <mass>0.0225974194</mass>
                <pose>-0.00016121771 -0.00081452055 0 0 0 0</pose>
                <inertia>
                    <ixx>1.0070887078e-05</ixx>
                    <ixy>-1.8768434113e-08</ixy>
                    <ixz>0</ixz>
                    <iyy>3.3684942311e-06</iyy>
                    <iyz>0</iyz>
                    <izz>7.0797253681e-06</izz>
                </inertia>
            </inertial>
            <visual name="end_effector_side_plate_${n}_visual">
                <xacro:mesh_geometry file="end_effector_side_plate.stl"/>
                <xacro:material_orange_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- differential_servo_link (×2) — driven (differential_pinion_joint_1/2 parents) -->
    <xacro:macro name="differential_servo" params="n relative_to">
        <link name="differential_servo_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0.0024 0.005 0 ${pi/2} ${pi/2} 0</pose>
            <inertial>
                <mass>0.0620599988</mass>
                <pose>0 0.0079594816 0.0055633688 0 0 0</pose>
                <inertia>
                    <ixx>6.9884428428e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>3.6553944820e-06</iyy>
                    <iyz>-3.4792797513e-08</iyz>
                    <izz>4.7934769497e-06</izz>
                </inertia>
            </inertial>
            <visual name="differential_servo_${n}_visual">
                <xacro:mesh_geometry file="Feetech-STS2032.stl"/>
                <xacro:material_black_abs/>
            </visual>
        </link>
    </xacro:macro>
    <!-- sts_circular_horn_link (×2) — driven (differential_pinion_joint_1/2 children) -->
    <xacro:macro name="sts_circular_horn_link" params="n relative_to">
        <link name="sts_circular_horn_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 -0.0110 0 0 0 ${pi/2}</pose>
            <xacro:inertial_sts_circular_horn/>
            <visual name="sts_circular_horn_${n}_visual">
                <xacro:mesh_geometry file="sts_circular_horn.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- end_effector_pinion_link (×2) — driven -->
    <xacro:macro name="end_effector_pinion" params="n relative_to">
        <link name="end_effector_pinion_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0.002 0 0 0 0 ${pi/2}</pose>
            <inertial>
                <mass>0.0031576875</mass>
                <pose>0 0.0080716975 0 0 0 0</pose>
                <inertia>
                    <ixx>1.2058613504e-07</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1.2922906781e-07</iyy>
                    <iyz>0</iyz>
                    <izz>1.2058567290e-07</izz>
                </inertia>
            </inertial>
            <visual name="end_effector_pinion_${n}_visual">
                <xacro:mesh_geometry file="end_effector_pinion.stl"/>
                <xacro:material_black_abs/>
            </visual>
        </link>
    </xacro:macro>
    <!-- virtual_pivot_link (×3) -->
    <xacro:macro name="virtual_pivot_link" params="n relative_to">
        <link name="virtual_pivot_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 0 0 0 0</pose>
        </link>
    </xacro:macro>
    <!-- ══════════════════════════════════════════════════════════
         JOINT MACROS
    ══════════════════════════════════════════════════════════ -->
    <!-- motor_joint_set — driven revolute + mimic free-horn (×3) -->
    <xacro:macro name="motor_joint_set" params="n">
        <joint name="motor_joint_${n}" type="revolute">
            <parent>servo_${n}</parent>
            <child>servo_${n}_horn</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
            <limit effort="2.0" velocity="11.1" lower="-3.14159" upper="3.14159"/>
        </joint>
        <joint name="motor_joint_${n}_free" type="revolute">
            <parent>servo_${n}</parent>
            <child>servo_${n}_free_horn</child>
            <axis>
                <xyz>0 1 0</xyz>
                <mimic joint="motor_joint_${n}">
                    <multiplier>1</multiplier>
                    <offset>0</offset>
                </mimic>
            </axis>
        </joint>
    </xacro:macro>
    <!-- ══════════════════════════════════════════════════════════
         MODEL
    ══════════════════════════════════════════════════════════ -->
    <model name="delta_robot">
        <!-- World anchor -->
        <link name="world_link">
            <pose>0 0 0 0 0 ${pi/2}</pose>
            <self_collide>false</self_collide>
            <inertial>
                <mass>0.01</mass>
                <inertia>
                    <ixx>1e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-05</iyy>
                    <iyz>0</iyz>
                    <izz>1e-05</izz>
                </inertia>
            </inertial>
        </link>
        <!-- Structural frame -->
        <link name="frame">
            <self_collide>false</self_collide>
            <static>true</static>
            <pose relative_to="world_link">0 0 -0.059454 0 0 0</pose>
            <inertial>
                <pose>0 0 0 0 0 0</pose>
                <mass>700.084375</mass>
                <inertia>
                    <ixx>4.0277965312</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.0964840312</iyy>
                    <iyz>0</iyz>
                    <izz>4.6133059896</izz>
                </inertia>
            </inertial>
            <collision name="frame_collision">
                <xacro:mesh_geometry file="frame.stl"/>
            </collision>
            <visual name="frame_visual">
                <xacro:mesh_geometry file="frame.stl"/>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
        <!-- Delta base plate -->
        <link name="delta_base">
            <self_collide>false</self_collide>
            <pose>0 0 -0.01 0 0 0</pose>
            <inertial>
                <mass>0.3507402885</mass>
                <pose>0 0 0.01 0 0 0</pose>
                <inertia>
                    <ixx>0.0001943686</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0001943686</iyy>
                    <iyz>0</iyz>
                    <izz>0.0003653545</izz>
                </inertia>
            </inertial>
            <visual name="delta_base_visual">
                <xacro:mesh_geometry file="delta_base-v1.stl"/>
                <xacro:material_aluminium/>
            </visual>
        </link>
        <!-- ─── Arm 1 ─── -->
        <xacro:servo_mount_link n="1"
            px=" 0.0787"  py=" 0.0"      pz="0.01"
            roll="${-pi/2}" pitch="0"    yaw="${pi/2}"/>
        <xacro:servo_link           n="1"/>
        <xacro:servo_horn_link      n="1"/>
        <xacro:servo_free_horn_link n="1"/>
        <xacro:bicep_link           n="1"/>
        <!-- ─── Arm 2 ─── -->
        <xacro:servo_mount_link n="2"
            px="-0.03935" py=" 0.06816"  pz="0.01"
            roll="${-pi/2}" pitch="0"    yaw="${-5*pi/6}"/>
        <xacro:servo_link           n="2"/>
        <xacro:servo_horn_link      n="2"/>
        <xacro:servo_free_horn_link n="2"/>
        <xacro:bicep_link           n="2"/>
        <!-- ─── Arm 3 ─── -->
        <xacro:servo_mount_link n="3"
            px="-0.03935" py="-0.06816"  pz="0.01"
            roll="${-pi/2}" pitch="0"    yaw="${-pi/6}"/>
        <xacro:servo_link           n="3"/>
        <xacro:servo_horn_link      n="3"/>
        <xacro:servo_free_horn_link n="3"/>
        <xacro:bicep_link           n="3"/>
        <!-- ─── Upper pivot arms ─── -->
        <xacro:pivot_arm_upper_link n="1"
            px=" 0.2"     py=" 0.0103"  pz="0"
            roll="${-pi/2}" pitch="0.6904480637777193" yaw="0"/>
        <xacro:pivot_arm_upper_link n="2"
            px="-0.10892" py=" 0.16806" pz="0"
            roll="${-pi/2}" pitch="0.6904480637777193" yaw="${2*pi/3}"/>
        <xacro:pivot_arm_upper_link n="3"
            px="-0.09108" py="-0.17836" pz="0"
            roll="${-pi/2}" pitch="0.6904480637777193" yaw="${-2*pi/3}"/>
        <!-- ─── Upper rod-caps ─── -->
        <xacro:rod_cap_upper_link n="1" relative_to="pivot_arm_1" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="2" relative_to="pivot_arm_1" z_offset=" 0.016"/>
        <xacro:rod_cap_upper_link n="3" relative_to="pivot_arm_2" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="4" relative_to="pivot_arm_2" z_offset=" 0.016"/>
        <xacro:rod_cap_upper_link n="5" relative_to="pivot_arm_3" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="6" relative_to="pivot_arm_3" z_offset=" 0.016"/>
        <!-- ─── Forearms ─── -->
        <xacro:forearm_link n="1" relative_to="rod_cap_1"/>
        <xacro:forearm_link n="2" relative_to="rod_cap_2"/>
        <xacro:forearm_link n="3" relative_to="rod_cap_3"/>
        <xacro:forearm_link n="4" relative_to="rod_cap_4"/>
        <xacro:forearm_link n="5" relative_to="rod_cap_5"/>
        <xacro:forearm_link n="6" relative_to="rod_cap_6"/>
        <!-- ─── Lower rod-caps ─── -->
        <xacro:rod_cap_lower_link n="7"  relative_to="forearm_1" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="8"  relative_to="forearm_2" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="9"  relative_to="forearm_3" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="10" relative_to="forearm_4" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="11" relative_to="forearm_5" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="12" relative_to="forearm_6" roll="${-pi/2}"/>
        <!-- ─── Detachable-joint auxiliary links ─── -->
        <xacro:detach_aux_link n="8"/>
        <xacro:detach_aux_link n="10"/>
        <xacro:detach_aux_link n="12"/>
        <!-- ─── Lower pivot arms ─── -->
        <xacro:pivot_arm_lower_link n="4" relative_to="rod_cap_7"/>
        <xacro:pivot_arm_lower_link n="5" relative_to="rod_cap_9"/>
        <xacro:pivot_arm_lower_link n="6" relative_to="rod_cap_11"/>
        <!-- ─── End-effector ─── -->
        <link name="end_effector">
            <self_collide>false</self_collide>
            <pose>0 0 -0.20276249142450614 ${-pi/2} 0 ${-pi/2}</pose>
            <inertial>
                <mass>0.0621005320</mass>
                <!-- driven: ixy/ixz/iyz < 1e-9 → zeroed; negligible CoM x/z offsets → zeroed -->
                <pose>0 0.00074779043 0 0 0 0</pose>
                <inertia>
                    <ixx>1.8996250596e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>3.0449052400e-05</iyy>
                    <iyz>0</iyz>
                    <izz>1.9011029793e-05</izz>
                </inertia>
            </inertial>
            <visual name="end_effector_visual">
                <xacro:mesh_geometry file="end_effector.stl"/>
                <xacro:material_orange_pla/>
            </visual>
        </link>
        <!-- ─── Differential mechanism ─── -->
        <!-- End-effector base plate -->
        <link name="end_effector_base_plate">
            <self_collide>false</self_collide>
            <pose relative_to="end_effector">0 0.0275 0 0 ${-pi/2} 0</pose>
            <inertial>
                <mass>0.0259212585</mass>
                <!-- driven: ixy/ixz/iyz < 1e-9 → zeroed; negligible CoM z offset → zeroed -->
                <pose>-7.9162824e-06 -0.00028473207 0 0 0 0</pose>
                <inertia>
                    <ixx>3.4857531278e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1.0518750147e-05</iyy>
                    <iyz>0</iyz>
                    <izz>7.6259718126e-06</izz>
                </inertia>
            </inertial>
            <visual name="end_effector_base_plate_visual">
                <xacro:mesh_geometry file="end_effector_base_plate.stl"/>
                <xacro:material_orange_pla/>
            </visual>
        </link>
        <xacro:end_effector_side_plate_link n="1" relative_to="end_effector_base_plate"/>
        <xacro:end_effector_side_plate_link n="2" relative_to="end_effector_base_plate"/>
        <xacro:differential_servo           n="1" relative_to="end_effector_side_plate_1"/>
        <xacro:differential_servo           n="2" relative_to="end_effector_side_plate_2"/>
        <xacro:sts_circular_horn_link       n="1" relative_to="differential_servo_1"/>
        <xacro:sts_circular_horn_link       n="2" relative_to="differential_servo_2"/>
        <xacro:end_effector_pinion          n="1" relative_to="sts_circular_horn_1"/>
        <xacro:end_effector_pinion          n="2" relative_to="sts_circular_horn_2"/>
        <link name="virtual_middle_shaft">
            <self_collide>false</self_collide>
            <pose relative_to="end_effector_pinion_1">0 0.028 0 ${-pi/2} 0 ${-pi/2}</pose>
        </link>
        <!-- Middle shaft — driven (differential_T_joint child) -->
        <link name="middle_shaft">
            <self_collide>false</self_collide>
            <pose relative_to="virtual_middle_shaft">0 0.0070 0 0 0 0</pose>
            <inertial>
                <mass>0.0162455078</mass>
                <!-- driven: all cross-terms < 1e-9 → zeroed; negligible CoM x/z offsets → zeroed -->
                <pose>0 -0.0047779764 0 0 0 0</pose>
                <inertia>
                    <ixx>1.0369267538e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1.4572444411e-06</iyy>
                    <iyz>0</iyz>
                    <izz>1.2758195299e-06</izz>
                </inertia>
            </inertial>
            <visual name="middle_shaft_visual">
                <xacro:mesh_geometry file="middle_shaft.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <!-- Bevel gear EE — driven (differential_EE_joint child) -->
        <link name="bevel_gear_ee">
            <self_collide>false</self_collide>
            <pose relative_to="middle_shaft">0 0.0035 0 ${pi} 0 0</pose>
            <inertial>
                <mass>0.0786202282</mass>
                <!-- driven: ixy/ixz/iyz all ~3e-10 → zeroed -->
                <pose>4.4545057e-07 -0.0075965684 -4.9079954e-07 0 0 0</pose>
                <inertia>
                    <ixx>8.4239996045e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1.1447685257e-05</iyy>
                    <iyz>0</iyz>
                    <izz>8.4244488324e-06</izz>
                </inertia>
            </inertial>
            <visual name="bevel_gear_ee_visual">
                <xacro:mesh_geometry file="end_effector_big_gear.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <link name="cube">
            <pose relative_to="bevel_gear_ee"> 0 -0.03775 0  ${-pi/2} 0 0</pose>
            <inertial>
                <mass>0.2190086521864867</mass>
                <pose>-0.0007571147448307052 -0.0004725953633605644 0.00028984668097712914 0.0 0.0 0.0</pose>
                <inertia>
                    <ixx>6.725551979614924e-05</ixx>
                    <iyy>6.782851202234727e-05</iyy>
                    <izz>6.74186794018338e-05</izz>
                    <ixy>8.080306097808026e-08</ixy>
                    <iyz>2.2480222406133124e-07</iyz>
                    <ixz>-1.1044106726896244e-07</ixz>
                </inertia>
            </inertial>
            <visual name="cube_visual">
                <xacro:mesh_geometry file="cube.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <link name="end_effector_pin">
            <self_collide>false</self_collide>
            <pose relative_to="cube">0 0 0 ${pi/2} ${pi/2} ${pi} </pose>
        </link>
        <!-- ─── Virtual pivot constraints ─── -->
        <xacro:virtual_pivot_link n="1" relative_to="pivot_arm_4"/>
        <xacro:virtual_pivot_link n="2" relative_to="pivot_arm_5"/>
        <xacro:virtual_pivot_link n="3" relative_to="pivot_arm_6"/>
        <!-- ══════════════════════════════════════════════════════════
             JOINTS
        ══════════════════════════════════════════════════════════ -->
        <!-- Frame chain -->
        <xacro:fixed_joint name="joint_world_to_frame" parent="world_link" child="frame"/>
        <xacro:fixed_joint name="joint_frame_to_base"  parent="frame"      child="delta_base"/>
        <!-- Servo mounts → base plate -->
        <xacro:fixed_joint name="delta_base_to_servo_mount_1" parent="delta_base" child="servo_mount_1"/>
        <xacro:fixed_joint name="delta_base_to_servo_mount_2" parent="delta_base" child="servo_mount_2"/>
        <xacro:fixed_joint name="delta_base_to_servo_mount_3" parent="delta_base" child="servo_mount_3"/>
        <!-- Servo bodies → servo mounts -->
        <xacro:fixed_joint name="servo_mount_1_to_servo_1" parent="servo_mount_1" child="servo_1"/>
        <xacro:fixed_joint name="servo_mount_2_to_servo_2" parent="servo_mount_2" child="servo_2"/>
        <xacro:fixed_joint name="servo_mount_3_to_servo_3" parent="servo_mount_3" child="servo_3"/>
        <!-- Motor joints — driven revolute + mimic free-horn -->
        <xacro:motor_joint_set n="1"/>
        <xacro:motor_joint_set n="2"/>
        <xacro:motor_joint_set n="3"/>
        <!-- Horns → biceps -->
        <xacro:fixed_joint name="servo_1_horn_to_bicep_1" parent="servo_1_horn" child="bicep_1"/>
        <xacro:fixed_joint name="servo_2_horn_to_bicep_2" parent="servo_2_horn" child="bicep_2"/>
        <xacro:fixed_joint name="servo_3_horn_to_bicep_3" parent="servo_3_horn" child="bicep_3"/>
        <!-- Biceps → upper pivot arms (passive revolute, Z) -->
        <xacro:revolute_joint name="bicep_1_to_pivot_arm_1" parent="bicep_1" child="pivot_arm_1" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="bicep_2_to_pivot_arm_2" parent="bicep_2" child="pivot_arm_2" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="bicep_3_to_pivot_arm_3" parent="bicep_3" child="pivot_arm_3" ax="0" ay="0" az="1"/>
        <!-- Upper pivot arms → upper rod-caps (passive revolute, X) -->
        <xacro:revolute_joint name="pivot_arm_1_to_rod_cap_1" parent="pivot_arm_1" child="rod_cap_1" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_1_to_rod_cap_2" parent="pivot_arm_1" child="rod_cap_2" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_2_to_rod_cap_3" parent="pivot_arm_2" child="rod_cap_3" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_2_to_rod_cap_4" parent="pivot_arm_2" child="rod_cap_4" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_3_to_rod_cap_5" parent="pivot_arm_3" child="rod_cap_5" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_3_to_rod_cap_6" parent="pivot_arm_3" child="rod_cap_6" ax="1" ay="0" az="0"/>
        <!-- Upper rod-caps → forearms -->
        <xacro:fixed_joint name="rod_cap_1_to_forearm_1"  parent="rod_cap_1"  child="forearm_1"/>
        <xacro:fixed_joint name="rod_cap_2_to_forearm_2"  parent="rod_cap_2"  child="forearm_2"/>
        <xacro:fixed_joint name="rod_cap_3_to_forearm_3"  parent="rod_cap_3"  child="forearm_3"/>
        <xacro:fixed_joint name="rod_cap_4_to_forearm_4"  parent="rod_cap_4"  child="forearm_4"/>
        <xacro:fixed_joint name="rod_cap_5_to_forearm_5"  parent="rod_cap_5"  child="forearm_5"/>
        <xacro:fixed_joint name="rod_cap_6_to_forearm_6"  parent="rod_cap_6"  child="forearm_6"/>
        <!-- Forearms → lower rod-caps -->
        <xacro:fixed_joint name="forearm_1_to_rod_cap_7"  parent="forearm_1"  child="rod_cap_7"/>
        <xacro:fixed_joint name="forearm_2_to_rod_cap_8"  parent="forearm_2"  child="rod_cap_8"/>
        <xacro:fixed_joint name="forearm_3_to_rod_cap_9"  parent="forearm_3"  child="rod_cap_9"/>
        <xacro:fixed_joint name="forearm_4_to_rod_cap_10" parent="forearm_4"  child="rod_cap_10"/>
        <xacro:fixed_joint name="forearm_5_to_rod_cap_11" parent="forearm_5"  child="rod_cap_11"/>
        <xacro:fixed_joint name="forearm_6_to_rod_cap_12" parent="forearm_6"  child="rod_cap_12"/>
        <!-- Lower rod-caps → lower pivot arms / aux links (passive revolute, X) -->
        <xacro:revolute_joint name="rod_cap_7_to_pivot_arm_4"     parent="rod_cap_7"  child="pivot_arm_4"    ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_8_to_rod_cap_8_aux"   parent="rod_cap_8"  child="rod_cap_8_aux"  ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_9_to_pivot_arm_5"     parent="rod_cap_9"  child="pivot_arm_5"    ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_10_to_rod_cap_10_aux" parent="rod_cap_10" child="rod_cap_10_aux" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_11_to_pivot_arm_6"    parent="rod_cap_11" child="pivot_arm_6"    ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_12_to_rod_cap_12_aux" parent="rod_cap_12" child="rod_cap_12_aux" ax="1" ay="0" az="0"/>
        <!-- DetachableJoint plugins -->
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_8_aux</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_4</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_10_aux</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_5</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_12_aux</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_6</child_link>
        </plugin>
        <!-- Virtual pivot joints (passive revolute, Z) -->
        <xacro:revolute_joint name="pivot_arm_4_to_virtual_pivot_1" parent="pivot_arm_4" child="virtual_pivot_1" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="pivot_arm_5_to_virtual_pivot_2" parent="pivot_arm_5" child="virtual_pivot_2" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="pivot_arm_6_to_virtual_pivot_3" parent="pivot_arm_6" child="virtual_pivot_3" ax="0" ay="0" az="1"/>
        <!-- Virtual pivots → end-effector -->
        <xacro:fixed_joint name="virtual_pivot_1_to_end_effector" parent="virtual_pivot_1" child="end_effector"/>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_2</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effector</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_3</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effector</child_link>
        </plugin>
        <!-- Differential mechanism joints -->
        <xacro:fixed_joint    name="end_effector_to_base_plate"   parent="end_effector"            child="end_effector_base_plate"/>
        <xacro:fixed_joint    name="base_plate_to_side_plate_1"   parent="end_effector_base_plate" child="end_effector_side_plate_1"/>
        <xacro:fixed_joint    name="base_plate_to_side_plate_2"   parent="end_effector_base_plate" child="end_effector_side_plate_2"/>
        <xacro:revolute_joint name="differential_T_joint"         parent="end_effector_base_plate" child="virtual_middle_shaft"           ax="-1" ay="0"  az="0"/>
        <xacro:fixed_joint    name="side_plate_1_to_diff_servo_1" parent="end_effector_side_plate_1" child="differential_servo_1"/>
        <xacro:fixed_joint    name="side_plate_2_to_diff_servo_2" parent="end_effector_side_plate_2" child="differential_servo_2"/>
        <xacro:fixed_joint    name="virtual_middle_shaft_to_middle_shaft"     parent="virtual_middle_shaft"     child="middle_shaft"/>
        <xacro:revolute_joint name="differential_EE_joint"        parent="middle_shaft"            child="bevel_gear_ee"          ax="0" ay="-1" az="0"/>
        <xacro:revolute_joint name="differential_pinion_joint_1"  parent="differential_servo_1"    child="sts_circular_horn_1"    ax="1" ay="0"  az="0"/>
        <xacro:revolute_joint name="differential_pinion_joint_2"  parent="differential_servo_2"    child="sts_circular_horn_2"    ax="1" ay="0"  az="0"/>
        <xacro:fixed_joint    name="sts_horn_1_to_ee_pinion_1"    parent="sts_circular_horn_1"     child="end_effector_pinion_1"/>
        <xacro:fixed_joint    name="sts_horn_2_to_ee_pinion_2"    parent="sts_circular_horn_2"     child="end_effector_pinion_2"/>
        <xacro:fixed_joint    name="bevel_gear_ee_to_cube" parent="bevel_gear_ee" child="cube"/>
        <xacro:fixed_joint    name="cube_to_end_effector_pin" parent="cube" child="end_effector_pin"/>
        <!-- ══════════════════════════════════════════════════════════
             ROS 2 CONTROL
        ══════════════════════════════════════════════════════════ -->
        <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <!-- Motor joints -->
    <joint name="motor_joint_1">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <joint name="motor_joint_2">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <joint name="motor_joint_3">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <!-- Differential joints -->
    <joint name="differential_pinion_joint_1">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <joint name="differential_pinion_joint_2">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <joint name="differential_T_joint">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
    
    <joint name="differential_EE_joint">
        <command_interface name="position"/>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
    </joint>
</ros2_control>
        <!-- ══════════════════════════════════════════════════════════
             PLUGINS
        ══════════════════════════════════════════════════════════ -->
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find delta_robot_sim)/config/ros2_controllers.yaml</parameters>
        </plugin>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <static_update_frequency>100</static_update_frequency>
        </plugin>
    </model>
</sdf>