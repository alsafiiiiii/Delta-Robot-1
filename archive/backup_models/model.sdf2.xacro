<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="material_aluminium">
        <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.95 0.95 0.95 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_anodised_aluminium">
        <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_aluminium">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_white_pla">
        <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_grey_pla">
        <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_pla">
        <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_abs">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_carbon_fiber">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="def_servo_mount" params="name rel_to pose">
        <link name="${name}">
            <pose relative_to="${rel_to}">${pose}</pose>
            <inertial>
                <mass>0.024127</mass>
                <inertia>
                    <ixx>3.756e-06</ixx>
                    <iyy>6.633e-06</iyy>
                    <izz>6.110e-06</izz>
                    <ixy>-4.690e-09</ixy>
                    <iyz>-5.069e-09</iyz>
                    <ixz>3.691e-07</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/servo_mount.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_servo" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0.00025 0.0 -0.021275 ${90 * pi / 180} ${90 * pi / 180} 0</pose>
            <inertial>
                <mass>0.266541</mass>
                <inertia>
                    <ixx>3.473e-05</ixx>
                    <iyy>5.714e-05</iyy>
                    <izz>6.567e-05</izz>
                    <ixy>-2.300e-07</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/servo.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_black_abs/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_horn1" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0.0125 0 0 0 0 ${180 * pi / 180}</pose>
            <inertial>
                <mass>0.006318</mass>
                <inertia>
                    <ixx>1.377e-07</ixx>
                    <iyy>2.590e-07</iyy>
                    <izz>1.377e-07</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/servo_horn1.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_horn2" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">-0.0125 0 0 0 0 0</pose>
            <inertial>
                <mass>0.005259</mass>
                <inertia>
                    <ixx>1.135e-07</ixx>
                    <iyy>2.191e-07</iyy>
                    <izz>1.135e-07</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/servo_horn2.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_bicep" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0.0125 0 0 0 0 ${90 * pi / 180}</pose>
            <inertial>
                <mass>0.029913</mass>
                <inertia>
                    <ixx>3.234e-05</ixx>
                    <iyy>5.924e-06</iyy>
                    <izz>3.551e-05</izz>
                    <ixy>0</ixy>
                    <iyz>-2.856e-07</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/bicep.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_white_pla/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_pivot" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">-0.01 0.1 0 -${90 * pi / 180} ${48.61254569 * pi / 180} ${90 * pi / 180}</pose>
            <inertial>
                <mass>0.039086</mass>
                <inertia>
                    <ixx>1.097e-05</ixx>
                    <iyy>1.226e-05</iyy>
                    <izz>1.920e-06</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/pivot_joint.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_grey_pla/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_rod_upper" params="name rel_to pose">
        <link name="${name}">
            <pose relative_to="${rel_to}">${pose}</pose>
            <inertial>
                <mass>0.022538</mass>
                <inertia>
                    <ixx>1.375e-06</ixx>
                    <iyy>9.165e-07</iyy>
                    <izz>9.896e-07</izz>
                    <ixy>0</ixy>
                    <iyz>-4.637e-08</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/rod_cap2.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_arm" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0 0.19 0 ${90 * pi / 180} ${180 * pi / 180} 0</pose>
            <inertial>
                <mass>0.040570</mass>
                <inertia>
                    <ixx>1.222e-04</ixx>
                    <iyy>1.222e-04</iyy>
                    <izz>1.755e-07</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/arm.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_carbon_fiber/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_rod_lower" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0 0 0 -${90 * pi / 180} ${180 * pi / 180} 0</pose>
            <inertial>
                <mass>0.022829</mass>
                <inertia>
                    <ixx>1.002e-06</ixx>
                    <iyy>9.283e-07</iyy>
                    <izz>1.393e-06</izz>
                    <ixy>4.697e-08</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/rod_cap2.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="def_lower_pivot" params="name rel_to">
        <link name="${name}">
            <pose relative_to="${rel_to}">0 -0.005 0.016 ${180 * pi / 180} 0 0</pose>
            <inertial>
                <mass>0.039086</mass>
                <inertia>
                    <ixx>1.097e-05</ixx>
                    <iyy>1.226e-05</iyy>
                    <izz>1.920e-06</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="${name}_vsl">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/pivot_joint.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_grey_pla/>
            </visual>
        </link>
    </xacro:macro>
    <xacro:macro name="joint_fixed" params="name parent child pose">
        <joint name="${name}" type="fixed">
            <pose>${pose}</pose>
            <parent>${parent}</parent>
            <child>${child}</child>
        </joint>
    </xacro:macro>
    <xacro:macro name="joint_actuated" params="name parent child pose axis">
        <joint name="${name}" type="revolute">
            <pose>${pose}</pose>
            <parent>${parent}</parent>
            <child>${child}</child>
            <axis>
                <xyz>${axis}</xyz>
                <limit>
                    <lower>-1.5708</lower>
                    <upper>1.5708</upper>
                    <effort>5.0</effort>
                    <velocity>10.0</velocity>
                </limit>
                <dynamics>
                    <damping>0.1</damping>
                    <friction>0.1</friction>
                </dynamics>
            </axis>
        </joint>
    </xacro:macro>
    <xacro:macro name="joint_passive" params="name parent child pose axis">
        <joint name="${name}" type="revolute">
            <pose>${pose}</pose>
            <parent>${parent}</parent>
            <child>${child}</child>
            <axis>
                <xyz>${axis}</xyz>
                <limit>
                    <lower>-1e16</lower>
                    <upper>1e16</upper>
                </limit>
                <dynamics>
                    <damping>0.001</damping>
                    <friction>0.001</friction>
                </dynamics>
            </axis>
        </joint>
    </xacro:macro>
    <xacro:macro name="joint_passive_mimic" params="name parent child pose axis mimic_joint multiplier">
        <joint name="${name}" type="revolute">
            <pose>${pose}</pose>
            <parent>${parent}</parent>
            <child>${child}</child>
            <axis>
                <xyz>${axis}</xyz>
                <limit>
                    <lower>-1e16</lower>
                    <upper>1e16</upper>
                </limit>
                <dynamics>
                    <damping>0.001</damping>
                    <friction>0.001</friction>
                </dynamics>
                <mimic joint="${mimic_joint}">
                    <multiplier>${multiplier}</multiplier>
                </mimic>
            </axis>
        </joint>
    </xacro:macro>
    <model name="delta_robot">
        <self_collide>false</self_collide>
        <link name="world_lnk_1" />
        <link name="Frame">
            <gravity>0</gravity>
            <self_collide>false</self_collide>
            <pose relative_to="world_lnk_1">0 0 0 0 0 0</pose>
            <inertial>
                <mass>74.084375</mass>
                <inertia>
                    <ixx>4.027796</ixx>
                    <iyy>4.096484</iyy>
                    <izz>4.613305</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <collision name="Frame_collision">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/frame.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
            </collision>
            <visual name="Frame_visual">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/frame.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
        <link name="base_link">
            <pose relative_to="Frame">0 0 0.05 0 0 0</pose>
            <inertial>
                <mass>0.350740</mass>
                <inertia>
                    <ixx>0.000194</ixx>
                    <iyy>0.000194</iyy>
                    <izz>0.000365</izz>
                    <ixy>0</ixy>
                    <iyz>0</iyz>
                    <ixz>0</ixz>
                </inertia>
            </inertial>
            <visual name="base_link_vsl_1">
                <geometry>
                    <mesh>
                        <uri>package://delta_robot_description/meshes/delta_base.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <xacro:material_aluminium/>
            </visual>
        </link>
        <joint name="virtual_joint" type="fixed">
            <parent>world_lnk_1</parent>
            <child>Frame</child>
        </joint>
        <joint name="base_frame" type="fixed">
            <parent>Frame</parent>
            <child>base_link</child>
        </joint>
        <xacro:def_servo_mount name="servo1_mount" rel_to="base_link" pose="0.061301 0 0.01 -${90 * pi / 180} 0 ${(0 * 120 + 90) * pi / 180}"/>
        <xacro:def_servo name="servo1" rel_to="servo1_mount"/>
        <xacro:def_horn1 name="servo1_horn1" rel_to="servo1"/>
        <xacro:def_horn2 name="servo1_horn2" rel_to="servo1"/>
        <xacro:def_bicep name="bicep1" rel_to="servo1_horn1"/>
        <xacro:def_pivot name="pivot_joint_1" rel_to="bicep1"/>
        <xacro:def_rod_upper name="rod_cap1" rel_to="pivot_joint_1" pose="0 0.005 0.016 0 0 0"/>
        <xacro:def_rod_upper name="rod_cap2" rel_to="pivot_joint_1" pose="0 0.005 -0.036 0 0 0"/>
        <xacro:def_arm name="arm_link_1" rel_to="rod_cap1"/>
        <xacro:def_arm name="arm_link_2" rel_to="rod_cap2"/>
        <xacro:def_rod_lower name="rod_cap7" rel_to="arm_link_1"/>
        <xacro:def_rod_lower name="rod_cap8" rel_to="arm_link_2"/>
        <xacro:def_lower_pivot name="pivot_joint_4" rel_to="rod_cap7"/>
        <xacro:joint_fixed name="base_to_servo_mount1" parent="base_link" child="servo1_mount" pose="0 0 0.0 0 0 0"/>
        <xacro:joint_fixed name="servo_mount1_to_servo1" parent="servo1_mount" child="servo1" pose="0.016 -0.01025 -0.013 0 0 0"/>
        <xacro:joint_actuated name="servo1_to_horn1" parent="servo1" child="servo1_horn1" pose="0.0125 0.0145 0 0 0 0" axis="0 1 0"/>
        <xacro:joint_fixed name="servo1_to_horn2" parent="servo1" child="servo1_horn2" pose="0.0125 -0.0145 0 0 0 0"/>
        <xacro:joint_fixed name="horn1_to_bicep1" parent="servo1_horn1" child="bicep1" pose="-0.0192 0.00803 0 0 0 0"/>
        <xacro:joint_passive name="bicep1_to_pivot1" parent="bicep1" child="pivot_joint_1" pose="0 0 -0.01 0 0 0" axis="0 0 1"/>
        <xacro:joint_passive name="pivot1_to_rod1" parent="pivot_joint_1" child="rod_cap1" pose="0 -0.005 0 0 0 0" axis="1 0 0"/>
        <xacro:joint_passive_mimic name="pivot1_to_rod2" parent="pivot_joint_1" child="rod_cap2" pose="0 -0.005 0 0 0 0" axis="1 0 0" mimic_joint="pivot1_to_rod1" multiplier="1.0"/>
        <xacro:joint_fixed name="rod1_to_arm1" parent="rod_cap1" child="arm_link_1" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="rod2_to_arm2" parent="rod_cap2" child="arm_link_2" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="arm1_to_rod7" parent="arm_link_1" child="rod_cap7" pose="0 0 0 0 0 0"/>
        <xacro:joint_fixed name="arm2_to_rod8" parent="arm_link_2" child="rod_cap8" pose="0 0 0 0 0 0"/>
        <xacro:joint_passive_mimic name="rod7_to_pivot4" parent="rod_cap7" child="pivot_joint_4" pose="0 0 0.016 0 0 0" axis="1 0 0" mimic_joint="pivot1_to_rod1" multiplier="1.0"/>
        <xacro:def_servo_mount name="servo2_mount" rel_to="base_link" pose="-0.030650 0.053088 0.01 -${90 * pi / 180} 0 ${(1 * 120 + 90) * pi / 180}"/>
        <xacro:def_servo name="servo2" rel_to="servo2_mount"/>
        <xacro:def_horn1 name="servo2_horn1" rel_to="servo2"/>
        <xacro:def_horn2 name="servo2_horn2" rel_to="servo2"/>
        <xacro:def_bicep name="bicep2" rel_to="servo2_horn1"/>
        <xacro:def_pivot name="pivot_joint_2" rel_to="bicep2"/>
        <xacro:def_rod_upper name="rod_cap3" rel_to="pivot_joint_2" pose="0 0.005 0.016 0 0 0"/>
        <xacro:def_rod_upper name="rod_cap4" rel_to="pivot_joint_2" pose="0 0.005 -0.036 0 0 0"/>
        <xacro:def_arm name="arm_link_3" rel_to="rod_cap3"/>
        <xacro:def_arm name="arm_link_4" rel_to="rod_cap4"/>
        <xacro:def_rod_lower name="rod_cap9" rel_to="arm_link_3"/>
        <xacro:def_rod_lower name="rod_cap10" rel_to="arm_link_4"/>
        <xacro:def_lower_pivot name="pivot_joint_5" rel_to="rod_cap9"/>
        <xacro:joint_fixed name="base_to_servo_mount2" parent="base_link" child="servo2_mount" pose="0 0 0.0 0 0 0"/>
        <xacro:joint_fixed name="servo_mount2_to_servo2" parent="servo2_mount" child="servo2" pose="0.016 -0.01025 -0.013 0 0 0"/>
        <xacro:joint_actuated name="servo2_to_horn1" parent="servo2" child="servo2_horn1" pose="0.0125 0.0145 0 0 0 0" axis="0 1 0"/>
        <xacro:joint_fixed name="servo2_to_horn2" parent="servo2" child="servo2_horn2" pose="0.0125 -0.0145 0 0 0 0"/>
        <xacro:joint_fixed name="horn1_to_bicep2" parent="servo2_horn1" child="bicep2" pose="-0.0192 0.00803 0 0 0 0"/>
        <xacro:joint_passive name="bicep2_to_pivot2" parent="bicep2" child="pivot_joint_2" pose="0 0 -0.01 0 0 0" axis="0 0 1"/>
        <xacro:joint_passive name="pivot2_to_rod3" parent="pivot_joint_2" child="rod_cap3" pose="0 -0.005 0 0 0 0" axis="1 0 0"/>
        <xacro:joint_passive_mimic name="pivot2_to_rod4" parent="pivot_joint_2" child="rod_cap4" pose="0 -0.005 0 0 0 0" axis="1 0 0" mimic_joint="pivot2_to_rod3" multiplier="1.0"/>
        <xacro:joint_fixed name="rod3_to_arm3" parent="rod_cap3" child="arm_link_3" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="rod4_to_arm4" parent="rod_cap4" child="arm_link_4" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="arm3_to_rod9" parent="arm_link_3" child="rod_cap9" pose="0 0 0 0 0 0"/>
        <xacro:joint_fixed name="arm4_to_rod10" parent="arm_link_4" child="rod_cap10" pose="0 0 0 0 0 0"/>
        <xacro:joint_passive_mimic name="rod9_to_pivot5" parent="rod_cap9" child="pivot_joint_5" pose="0 0.005 0.016 0 0 0" axis="-1 0 0" mimic_joint="pivot2_to_rod3" multiplier="1.0"/>
        <xacro:def_servo_mount name="servo3_mount" rel_to="base_link" pose="-0.030650 -0.053088 0.01 -${90 * pi / 180} 0 ${(2 * 120 + 90) * pi / 180}"/>
        <xacro:def_servo name="servo3" rel_to="servo3_mount"/>
        <xacro:def_horn1 name="servo3_horn1" rel_to="servo3"/>
        <xacro:def_horn2 name="servo3_horn2" rel_to="servo3"/>
        <xacro:def_bicep name="bicep3" rel_to="servo3_horn1"/>
        <xacro:def_pivot name="pivot_joint_3" rel_to="bicep3"/>
        <xacro:def_rod_upper name="rod_cap5" rel_to="pivot_joint_3" pose="0 0.005 0.016 0 0 0"/>
        <xacro:def_rod_upper name="rod_cap6" rel_to="pivot_joint_3" pose="0 0.005 -0.036 0 0 0"/>
        <xacro:def_arm name="arm_link_5" rel_to="rod_cap5"/>
        <xacro:def_arm name="arm_link_6" rel_to="rod_cap6"/>
        <xacro:def_rod_lower name="rod_cap11" rel_to="arm_link_5"/>
        <xacro:def_rod_lower name="rod_cap12" rel_to="arm_link_6"/>
        <xacro:def_lower_pivot name="pivot_joint_6" rel_to="rod_cap11"/>
        <xacro:joint_fixed name="base_to_servo_mount3" parent="base_link" child="servo3_mount" pose="0 0 0.0 0 0 0"/>
        <xacro:joint_fixed name="servo_mount3_to_servo3" parent="servo3_mount" child="servo3" pose="0.016 -0.01025 -0.013 0 0 0"/>
        <xacro:joint_actuated name="servo3_to_horn1" parent="servo3" child="servo3_horn1" pose="0.0125 0.0145 0 0 0 0" axis="0 1 0"/>
        <xacro:joint_fixed name="servo3_to_horn2" parent="servo3" child="servo3_horn2" pose="0.0125 -0.0145 0 0 0 0"/>
        <xacro:joint_fixed name="horn1_to_bicep3" parent="servo3_horn1" child="bicep3" pose="-0.0192 0.00803 0 0 0 0"/>
        <xacro:joint_passive name="bicep3_to_pivot3" parent="bicep3" child="pivot_joint_3" pose="0 0 -0.01 0 0 0" axis="0 0 1"/>
        <xacro:joint_passive name="pivot3_to_rod5" parent="pivot_joint_3" child="rod_cap5" pose="0 -0.005 0 0 0 0" axis="1 0 0"/>
        <xacro:joint_passive_mimic name="pivot3_to_rod6" parent="pivot_joint_3" child="rod_cap6" pose="0 -0.005 0 0 0 0" axis="1 0 0" mimic_joint="pivot3_to_rod5" multiplier="1.0"/>
        <xacro:joint_fixed name="rod5_to_arm5" parent="rod_cap5" child="arm_link_5" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="rod6_to_arm6" parent="rod_cap6" child="arm_link_6" pose="0 0 0.19 0 0 0"/>
        <xacro:joint_fixed name="arm5_to_rod11" parent="arm_link_5" child="rod_cap11" pose="0 0 0 0 0 0"/>
        <xacro:joint_fixed name="arm6_to_rod12" parent="arm_link_6" child="rod_cap12" pose="0 0 0 0 0 0"/>
        <xacro:joint_passive_mimic name="rod11_to_pivot6" parent="rod_cap11" child="pivot_joint_6" pose="0 0.005 0.016 0 0 0" axis="-1 0 0" mimic_joint="pivot3_to_rod5" multiplier="1.0"/>
       
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_2</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effctr1-_1</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_3</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effctr1-_1</child_link>
        </plugin>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find delta_robot_sim)/config/ros2_controllers.yaml</parameters>
        </plugin>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <static_update_frequency>100</static_update_frequency>
        </plugin>
        <ros2_control name="IgnitionSystem" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="servo1_to_horn1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="servo2_to_horn1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="servo3_to_horn1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </model>
</sdf>