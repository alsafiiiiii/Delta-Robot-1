        <link name="vacuum_gripper">
            <pose relative_to="EE">0 0 -0.01 0 0 0</pose>
            <inertial>
                <mass>0.0001</mass>
                <inertia>
                    <ixx>1e-6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-6</iyy>
                    <iyz>0</iyz>
                    <izz>1e-6</izz>
                </inertia>
            </inertial>
            <visual name="vacuum_gripper_visual">
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.02</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.1 0.1 0.1 1</diffuse>
                </material>
            </visual>
            <collision name="vacuum_gripper_collision">
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.02</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>
        <joint name="vacuum_gripper_joint" type="fixed">
            <parent>EE</parent>
            <child>vacuum_gripper</child>
        </joint>
        <plugin filename="libsuction_plugin.so" name="gz::sim::v8::systems::SuctionPlugin">
            <suction_topic>/suction/enable</suction_topic>
            <link_name>vacuum_gripper</link_name>
            <use_suction_radius>true</use_suction_radius>
            <suction_radius>0.062</suction_radius>
            <suction_force>10.0</suction_force>
        </plugin>
    </model>
