        <joint name="virtual_joint" type="fixed">
            <parent>world_link</parent>
            <child>base_link</child>
        </joint>
        <joint name="base_joint" type="fixed">
            <parent>base_link</parent>
            <child>base_hex</child>
            <pose>0 0 0 0 0 0</pose>
        </joint>

        <joint name="jbf1" type="revolute">
            <parent>base_hex</parent>
            <child>forearm1</child>
            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-2.007</lower>
                    <upper>2.007</upper>
                    <effort>2.0</effort>
                    <velocity>5.0</velocity>
                </limit>
                <dynamics>
                    <damping>0.1</damping>
                    <friction>0.05</friction>
                </dynamics>
            </axis>
        </joint>
        <joint name="jbf2" type="revolute">
