					<friction>0.01</friction>
				</dynamics>
			</axis>
		</joint>
		<joint name="Tj1" type="revolute">
			<parent>EEBase</parent>
			<child>T</child>
			<pose>0.0 0.0 0.005048116 0 0 0</pose>
			<axis>
				<xyz>1 0 0</xyz>
				<limit>
					<lower>-3.14159</lower>
					<upper>3.14159</upper>
					<effort>50.0</effort>
					<velocity>10.0</velocity>
				</limit>
