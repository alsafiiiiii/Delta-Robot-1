		<!-- End Effector Control Joints -->
		<joint name="Bevelj1" type="revolute">
			<parent>EEBase</parent>
			<child>Bevel1</child>
			<axis>
				<xyz>1 0 0</xyz>
				<limit>
					<lower>-3</lower>
					<upper>3</upper>
					<effort>50.0</effort>
					<velocity>10.0</velocity>
				</limit>
				<dynamics>
					<damping>1.0</damping>
					<friction>0.01</friction>
				</dynamics>
			</axis>
		</joint>
		<joint name="Bevelj2" type="revolute">
			<parent>EEBase</parent>
			<child>Bevel2</child>
			<axis>
				<xyz>-1 0 0</xyz>
				<limit>
					<lower>-3</lower>
					<upper>3</upper>
